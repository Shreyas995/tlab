#!/bin/bash
#PBS -N hip_shmwrite_test
#PBS -l select=2:node_type=mi300a:mpiprocs=24
#PBS -l walltime=00:02:00

ulimit -c unlimited
export HSA_XNACK=1
export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1

# Set this to the directory where vmpi_hip_shmwrite.x was compiled
cd ~/tlab_test/src/valid/mpi

# Using Cray mpiexec with appropriate binding for AMD MI300A
mpiexec -n 48 --ppn 24 \
  --cpu-bind=core \
  --depth=1 \
  ./vmpi_hip_shmwrite.x 4 12 512 > output_hip.log 2>&1

echo "Job completed"